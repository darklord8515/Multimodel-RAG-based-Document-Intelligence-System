# Copy to .env and fill in your key. .env is git-ignored.
LLM_BINDING_API_KEY=your-groq-api-key
LLM_BINDING_HOST=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b

# Local embeddings (Groq has no embeddings endpoint). Dim must match the model.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Optional
# HOST=127.0.0.1
# PORT=8765
# DATA_DIR=./data
# MAX_UPLOAD_MB=50
# LLM_MAX_ASYNC=2
# CHUNK_TOKEN_SIZE=800
